rules_version = '2';
// ── App Check enforcement ─────────────────────────────────────────────────────
// Token validation is enforced in the Firebase console, not in rules.
// To enable: Firebase console → App Check → Firestore → Enforce.
// Rules below assume an authenticated user; App Check adds a second layer that
// blocks unauthenticated SDK calls entirely before rules are even evaluated.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // Role is read from custom claims (set by adminCreateUser / setUserRole CFs).
    // This is faster than a Firestore get() and works even before the user doc exists.
    function getRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'admin';
    }

    // admin + dispatch
    function isDispatch() {
      return isAuthenticated() && getRole() in ['admin', 'dispatch'];
    }

    function isDriver() {
      return isAuthenticated() && getRole() == 'driver';
    }

    // True when the caller is a portal customer user (any customer sub-role).
    function isPortalUser() {
      return isAuthenticated()
        && getRole() in ['customer', 'owner', 'manager', 'billing', 'delivery', 'viewer'];
    }

    // Returns the companyId from the custom claim.
    function linkedCompanyId() {
      return request.auth.token.companyId;
    }

    function isSales() {
      // Claims-only — avoids a get() on users/{uid} which fails for brand-new
      // accounts whose doc hasn't been written yet.
      return isAuthenticated() && getRole() in ['admin', 'sales'];
    }

    function isCustomer() {
      return isAuthenticated() && getRole() == 'customer';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Returns the customerId from the custom claim (set by adminCreateUser CF).
    // Falls back to a Firestore read only if the claim is absent (legacy accounts).
    function linkedCustomerId() {
      return request.auth.token.customerId != null
        ? request.auth.token.customerId
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId;
    }

    // True when the write only touches the listed field names.
    function onlyUpdatesFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Internal pricing fields must live in /productPricing, never /products.
    function hasNoInternalPricingFields() {
      return !('cost' in request.resource.data)
        && !('minMarginPercent' in request.resource.data)
        && !('minPrice' in request.resource.data);
    }


    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isOwner(userId) || isDispatch() || isSales();
      allow create: if isAdmin() || isOwner(userId); // self-create on sign-up
      // Users may update their own non-sensitive profile fields only.
      allow update: if isAdmin()
        || (isOwner(userId)
            && onlyUpdatesFields(['name', 'phone', 'avatarUrl', 'updatedAt',
                                   'smsOptIn', 'smsPhone', 'smsConsentAt',
                                   'pwaInstallPrompted', 'notificationPrefs']));
      allow delete: if isAdmin();
    }


    // ── Customers (companies) ─────────────────────────────────────────────────
    // status lifecycle: active | inactive | hold → archived → deleted (purged after 30 days)
    //
    // "Overwrite" semantics for deleted docs:
    //   A soft-deleted document (status == 'deleted') can be restored or overwritten
    //   by admins via update — the doc ID is preserved so foreign-key references in
    //   orders/invoices/tanks remain valid during the 30-day grace window.
    //   New customer sign-ups always use addDoc (auto-ID) so they never collide with
    //   existing deleted documents.
    match /customers/{customerId} {
      // Deleted/archived customers are invisible to portal users — only ops staff
      // and admins may read them.
      allow read: if isDispatch()
        || isSales()
        || (isPortalUser() && linkedCompanyId() == customerId
            && !(resource.data.status in ['deleted', 'archived']))
        || (isCustomer() && linkedCustomerId() == customerId
            && !(resource.data.status in ['deleted', 'archived']));
      // Any authenticated user may create a company doc (sign-up flow).
      allow create: if isAuthenticated();
      // Admins can update any customer including deleted/archived ones (restore/overwrite).
      // Other ops staff can update non-deleted customers only.
      allow update: if isAdmin()
        || (isDispatch() && resource.data.status != 'deleted')
        || (isSales()    && resource.data.status != 'deleted')
        || (isPortalUser() && linkedCompanyId() == customerId
            && resource.data.status != 'deleted'
            && resource.data.status != 'archived');
      // Hard-delete is admin-only; soft-delete is handled via update above.
      allow delete: if isAdmin();

      // Customer-scoped tanks (mirrors the top-level /tanks collection).
      match /tanks/{tankId} {
        allow read:  if isDispatch()
          || (isCustomer() && linkedCustomerId() == customerId)
          || (isPortalUser() && linkedCompanyId() == customerId);
        allow write: if isDispatch();
      }

      // Payment methods are managed exclusively via Stripe + Cloud Functions.
      match /paymentMethods/{pmId} {
        allow read:  if isDispatch()
          || (isCustomer() && linkedCustomerId() == customerId)
          || (isPortalUser() && linkedCompanyId() == customerId);
        allow write: if false;
      }

      // Per-customer product pricing (set by sales/dispatch; read by portal users)
      match /productPricing/{productId} {
        allow read:  if isDispatch()
          || isSales()
          || (isPortalUser() && linkedCompanyId() == customerId)
          || (isCustomer() && linkedCustomerId() == customerId);
        allow write: if isDispatch() || isSales();
      }

      // Delivery locations under the company
      match /locations/{locationId} {
        allow read:  if isDispatch()
          || (isPortalUser() && linkedCompanyId() == customerId);
        allow write: if isDispatch()
          || (isPortalUser() && linkedCompanyId() == customerId
              && getRole() in ['owner', 'manager', 'admin']);
      }
    }


    // ── Tanks (top-level) ─────────────────────────────────────────────────────
    match /tanks/{tankId} {
      allow read:  if isDispatch() || isDriver()
        || (isCustomer() && resource.data.customerId == linkedCustomerId());
      // Drivers can update tanks for load check-in, delivery, and return.
      allow update: if isDispatch()
        || (isDriver() && (
          // Loading any non-deployed tank onto their truck (available, returned, inspection → on_truck)
          (request.resource.data.status == 'on_truck'
           && request.resource.data.driverId == request.auth.uid)
          // Delivering on_truck → deployed (their truck only)
          || (resource.data.status == 'on_truck' && resource.data.driverId == request.auth.uid
              && request.resource.data.status == 'deployed')
          // Checking in deployed → returned
          || (resource.data.status == 'deployed' && request.resource.data.status == 'returned')
        ));
      // Drivers may create new tank docs for unknown tanks scanned during load check-in
      allow create: if isDispatch() || isDriver();
      allow delete: if isDispatch();

      match /events/{eventId} {
        allow read:  if isDispatch() || isDriver()
          || (isCustomer() && get(/databases/$(database)/documents/tanks/$(tankId)).data.customerId == linkedCustomerId());
        allow create: if isDispatch() || isDriver();
        allow update, delete: if false;
      }
    }


    // ── Orders ────────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isDispatch()
        || isSales()
        || (isCustomer() && resource.data.customerId == linkedCustomerId());
      allow create: if isDispatch() || isSales() || isCustomer();
      // Dispatch may change any field.
      // Drivers may only record delivery outcome — no financial fields.
      allow update: if isAdmin()
        || isDispatch()
        || (isDriver()
            && onlyUpdatesFields(['status', 'gallonsDelivered', 'deliveredAt', 'notes', 'updatedAt']));
      allow delete: if isAdmin();
    }


    // ── Runs ──────────────────────────────────────────────────────────────────
    match /runs/{runId} {
      allow read:           if isDispatch() || isDriver();
      allow create, delete: if isDispatch();
      // Drivers may update load/start fields on runs assigned to them.
      allow update: if isDispatch()
        || (isDriver()
            && resource.data.driverId == request.auth.uid
            && onlyUpdatesFields(['loadStatus', 'loadCompletedAt', 'loadedBy',
                                   'status', 'startedAt', 'updatedAt']));

      // Run stops (subcollection)
      match /stops/{stopId} {
        allow read:          if isDispatch() || isDriver();
        allow create, delete: if isDispatch();
        // Drivers may update stops only on runs assigned to them.
        allow update: if isDispatch()
          || (isDriver()
              && get(/databases/$(database)/documents/runs/$(runId)).data.driverId
                 == request.auth.uid
              && onlyUpdatesFields([
                   'status', 'arrivedAt', 'completedAt', 'gallonsDelivered',
                   'notes', 'photoUrls', 'signatureUrl', 'signedAt',
                   'signedByName', 'billOfLadingUrl', 'invoicePdfUrl'
                 ]));
      }

      // Truck load manifest (subcollection written by QR scan check-in)
      match /manifest/{cylinderId} {
        allow read:   if isDispatch() || isDriver();
        allow create: if isDispatch() || isDriver();
        allow update: if isDispatch()
          || (isDriver()
              && get(/databases/$(database)/documents/runs/$(runId)).data.driverId
                 == request.auth.uid);
        allow delete: if isDispatch();
      }

      // Missing-cylinder flags raised by drivers during load check-in
      match /flags/{flagId} {
        allow read:   if isDispatch() || isDriver();
        allow create: if isDispatch() || isDriver();
        allow update: if isDispatch();
        allow delete: if isDispatch();
      }
    }


    // ── Invoices ──────────────────────────────────────────────────────────────
    match /invoices/{invoiceId} {
      allow read: if isDispatch()
        || isSales()
        || (isCustomer() && resource.data.customerId == linkedCustomerId())
        || (isPortalUser() && resource.data.customerId == linkedCompanyId());
      allow write: if isAdmin() || isDispatch();
    }


    // ── Payments ──────────────────────────────────────────────────────────────
    // All payment writes go through Firebase Functions with the Admin SDK.
    // Client-side writes are never permitted.
    match /payments/{paymentId} {
      allow read: if isDispatch()
        || (isCustomer() && resource.data.customerId == linkedCustomerId())
        || (isPortalUser() && resource.data.customerId == linkedCompanyId());
      allow write: if false;
    }


    // ── Files / generated documents ─────────────────────────────────────────
    match /files/{fileId} {
      allow read: if isDispatch()
        || isSales()
        || (
          isPortalUser()
          && resource.data.entityType == 'customer'
          && resource.data.entityId == linkedCompanyId()
        )
        || (
          isCustomer()
          && resource.data.entityType == 'customer'
          && resource.data.entityId == linkedCustomerId()
        );
      allow create: if isDispatch()
        || isSales()
        || (
          isPortalUser()
          && request.resource.data.entityType == 'customer'
          && request.resource.data.entityId == linkedCompanyId()
        );
      allow update, delete: if isDispatch() || isSales();
    }


    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      // Users may only mark their own notifications as read.
      allow update: if isAuthenticated()
        && isOwner(resource.data.userId)
        && onlyUpdatesFields(['read']);
      allow create, delete: if false; // Functions only
    }


    // ── Products (price catalog) ──────────────────────────────────────────────
    match /products/{productId} {
      allow read:   if isAuthenticated();
      allow create: if isAdmin() && hasNoInternalPricingFields();
      allow update: if isAdmin() && hasNoInternalPricingFields();
      allow delete: if isAdmin();
    }


    // ── Internal product pricing (cost/margin controls) ─────────────────────
    match /productPricing/{productId} {
      allow read: if isSales();
      allow write: if isAdmin();
    }


    // ── Leads ─────────────────────────────────────────────────────────────────
    match /leads/{leadId} {
      allow read, write: if isSales();
    }


    // ── Quotes ────────────────────────────────────────────────────────────────
    match /quotes/{quoteId} {
      allow read: if isSales()
        || (isPortalUser() && resource.data.customerId == linkedCompanyId())
        || (isCustomer() && resource.data.customerId == linkedCustomerId());
      allow write: if isSales();
    }


    // ── Contact logs ──────────────────────────────────────────────────────────
    match /contactLogs/{logId} {
      allow read, write: if isSales();
    }


    // ── Cylinders (physical asset registry) ──────────────────────────────────
    // Drivers need read access to validate scanned QR codes and write access
    // to update status during truck load check-in and delivery.
    match /cylinders/{cylinderId} {
      allow read:   if isDispatch() || isDriver();
      allow create: if isDispatch() || isDriver();
      allow update: if isDispatch()
        || (isDriver() && onlyUpdatesFields([
          'status', 'currentRunId', 'lastScannedAt', 'lastScannedBy', 'updatedAt'
        ]));
      allow delete: if isDispatch();
    }


    // ── Invites ───────────────────────────────────────────────────────────────
    match /invites/{inviteId} {
      // Bearer of the inviteId can read (for accept flow, even unauthenticated
      // users need to read before signing up — allow any authenticated read).
      allow read:   if isAuthenticated();
      // Only Cloud Functions write invites.
      allow write:  if false;
    }


    // ── Join Requests ─────────────────────────────────────────────────────────
    match /joinRequests/{requestId} {
      // Requester can read their own; company owner/manager + admin can read all for company.
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.uid == request.auth.uid)
        || (isPortalUser() && resource.data.companyId == linkedCompanyId()
            && getRole() in ['owner', 'manager']);
      // Only Cloud Functions write join requests.
      allow write: if false;
    }


    // ── Credit Applications ───────────────────────────────────────────────────
    match /creditApplications/{companyId} {
      allow read: if isAdmin()
        || isDispatch()
        || (isPortalUser() && linkedCompanyId() == companyId);
      // Portal users submit their own credit application.
      allow create: if isPortalUser() && linkedCompanyId() == companyId;
      // Only admins/dispatch may update (for status changes).
      allow update: if isDispatch();
      allow delete: if isAdmin();
    }


    // ── Quote Requests ────────────────────────────────────────────────────────
    match /quoteRequests/{quoteId} {
      allow read: if isAdmin()
        || isDispatch()
        || (isPortalUser() && resource.data.companyId == linkedCompanyId());
      // Portal owner submits quote request on onboarding completion.
      allow create: if isPortalUser() && request.resource.data.companyId == linkedCompanyId();
      // Ops updates the status/quote fields.
      allow update: if isDispatch();
      allow delete: if isAdmin();
    }


    // ── Sales Pipeline Leads ──────────────────────────────────────────────────
    // leads/{companyId} — 1:1 with customers/{companyId}, sales workflow state
    match /leads/{companyId} {
      allow read: if request.auth.token.role == 'admin'
        || request.auth.token.role == 'sales'
        || request.auth.token.role == 'dispatch';
      // Sales reps and admins write leads; Cloud Functions also write via admin SDK (bypasses rules)
      allow write: if request.auth.token.role == 'admin'
        || request.auth.token.role == 'sales';
    }


    // ── App-level settings (delivery, company, etc.) ──────────────────────────
    match /settings/{docId} {
      // Any authenticated staff member needs to read settings (e.g. delivery fees in order builder).
      allow read:  if isAuthenticated();
      // Only admins may write settings.
      allow write: if isAdmin();
    }


    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
