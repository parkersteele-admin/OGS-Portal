# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=
# Google Maps
VITE_GOOGLE_MAPS_API_KEY=
# App
VITE_APP_ENV=development
VITE_APP_URL=
# Set to "true" locally to route all Firebase calls through the emulators
VITE_USE_EMULATORS=false
# reCAPTCHA v3 site key — required in production for Firebase App Check
VITE_RECAPTCHA_SITE_KEY=
# App Check debug token — development/staging only, NEVER commit a real value.
# Leave blank to auto-generate a token (printed to console; register it in Firebase console).
VITE_APPCHECK_DEBUG_TOKEN=
